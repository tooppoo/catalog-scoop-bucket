{
  "name": "scoop-dev",
  "image": "mcr.microsoft.com/devcontainers/base:2.1.11-trixie",
  "workspaceFolder": "/workspaces/catalog-scoop-bucket",
  "remoteUser": "vscode",
  "runArgs": [
    "--name", "scoop",
    "--userns=keep-id"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/tooppoo/catalog-devcontainer-features/git-kura:0": {},
    "ghcr.io/tooppoo/catalog-devcontainer-features/rellog:0": {},
    "ghcr.io/tooppoo/catalog-devcontainer-features/reportage:0": {},
    "ghcr.io/tooppoo/catalog-devcontainer-features/enozunu:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}
